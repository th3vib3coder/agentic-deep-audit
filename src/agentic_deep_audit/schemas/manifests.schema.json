{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Manifests",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "records"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "repo": {
      "type": "object"
    },
    "source_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skipped": {
      "type": "boolean"
    },
    "skip_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "skipped",
          "skip_reason",
          "evidence_ids"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "skipped": {
            "type": "boolean"
          },
          "skip_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^ev-[0-9]{6,}$"
            }
          },
          "ecosystem": {
            "type": "string"
          },
          "package_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "build_system": {
            "type": [
              "string",
              "null"
            ]
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "specifier": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "scope": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "scripts": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/observedCommand"
            }
          },
          "lockfiles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "observedCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "category",
        "source",
        "origin",
        "policy_decision",
        "policy_rule",
        "label"
      ],
      "properties": {
        "command": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "origin": {
          "type": "string"
        },
        "policy_decision": {
          "type": "string"
        },
        "policy_rule": {
          "type": "string"
        },
        "label": {
          "const": "observed, not executed"
        }
      }
    }
  }
}
