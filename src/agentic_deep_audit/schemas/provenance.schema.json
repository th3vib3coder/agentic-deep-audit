{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "git"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "repo": {
      "type": "object"
    },
    "generated_at": {
      "type": "string"
    },
    "source_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "enum": [
              "git",
              "github"
            ]
          }
        }
      }
    },
    "skipped": {
      "type": "boolean"
    },
    "skip_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "git": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "observed",
            "failed",
            "skipped"
          ]
        },
        "target_path": {
          "type": "string"
        },
        "repo_root": {
          "type": "string"
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "dirty": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "tracked_file_count": {
          "type": "integer",
          "minimum": 0
        },
        "remotes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "url"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "submodules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "path",
              "url"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "path": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "auth_mode",
        "metadata_status"
      ],
      "properties": {
        "target": {
          "type": [
            "string",
            "null"
          ]
        },
        "auth_mode": {
          "type": "string"
        },
        "metadata_status": {
          "type": "string"
        }
      }
    }
  }
}
