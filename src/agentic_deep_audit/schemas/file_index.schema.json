{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "File Index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repo",
    "records"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "repo": {
      "type": "object"
    },
    "generated_at": {
      "type": "string"
    },
    "source_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "path_normalized",
          "size_bytes",
          "sha256",
          "extension",
          "kind",
          "binary"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "path_normalized": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string"
          },
          "extension": {
            "type": "string"
          },
          "language": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "enum": [
              "asset",
              "binary",
              "code",
              "config",
              "data",
              "docs",
              "generated",
              "test",
              "unknown",
              "vendored"
            ]
          },
          "binary": {
            "type": "boolean"
          }
        }
      }
    },
    "skipped": {
      "type": "boolean"
    },
    "skip_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "skipped_paths": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "reason"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "root_documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status",
          "path"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "found",
              "missing"
            ]
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
