{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Special Implementations",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidates"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "name",
          "kind",
          "files",
          "coupling",
          "dependencies",
          "license_status_source",
          "performance_note",
          "limitations",
          "evidence_ids"
        ],
        "properties": {
          "candidate_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "algorithm",
              "data_structure",
              "optimization",
              "reusable_component"
            ]
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "coupling": {
            "enum": [
              "low",
              "medium",
              "high",
              "unknown"
            ]
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "license_status_source": {
            "type": "string",
            "pattern": "^(unknown_requires_license_card|root_license:ev-[0-9]{6,}|file_evidence:ev-[0-9]{6,}|dependency_evidence:ev-[0-9]{6,})$"
          },
          "performance_note": {
            "type": "string"
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^ev-[0-9]{6,}$"
            },
            "minItems": 1
          }
        }
      }
    },
    "skipped": {
      "type": "boolean"
    },
    "skip_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "total_eligible": {
      "type": "integer"
    },
    "truncated": {
      "type": "boolean"
    }
  }
}
