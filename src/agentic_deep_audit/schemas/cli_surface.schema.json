{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CLI Surface",
  "type": "object",
  "required": ["schema_version", "records"],
  "properties": {
    "schema_version": {"type": "string"},
    "run_id": {"type": ["string", "null"]},
    "repo": {"type": "object"},
    "source_artifacts": {"type": "array", "items": {"type": "string"}},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["surface_id", "kind", "source_path", "status", "confidence", "evidence_ids", "sanitizer_decision", "executable", "observed_not_executed"],
        "properties": {
          "surface_id": {"type": "string"},
          "kind": {"enum": ["manifest_script", "node_bin", "cargo_bin", "go_command", "python_main_guard"]},
          "source_path": {"type": "string"},
          "status": {"enum": ["observed", "heuristic", "skipped"]},
          "confidence": {"enum": ["high", "medium", "low"]},
          "evidence_ids": {"type": "array", "items": {"type": "string"}},
          "sanitizer_decision": {"type": "string"},
          "command": {"type": ["string", "null"]},
          "category": {"type": ["string", "null"]},
          "name": {"type": ["string", "null"]},
          "entrypoint": {"type": ["string", "null"]},
          "policy_rule": {"type": ["string", "null"]},
          "executable": {"const": false},
          "observed_not_executed": {"const": true}
        }
      }
    },
    "skipped": {"type": "boolean"},
    "skip_reason": {"type": ["string", "null"]},
    "coverage": {"type": "object"}
  }
}
