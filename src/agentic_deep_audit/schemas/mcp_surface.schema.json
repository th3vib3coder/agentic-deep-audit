{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MCP Surface",
  "type": "object",
  "required": ["schema_version", "records"],
  "properties": {
    "schema_version": {"type": "string"},
    "run_id": {"type": ["string", "null"]},
    "repo": {"type": "object"},
    "source_artifacts": {"type": "array", "items": {"type": "string"}},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["surface_id", "kind", "source_path", "status", "confidence", "evidence_ids", "sanitizer_decision", "host_imported", "audit_only"],
        "properties": {
          "surface_id": {"type": "string"},
          "kind": {"enum": ["target_mcp_config"]},
          "source_path": {"type": "string"},
          "status": {"enum": ["observed", "heuristic", "skipped"]},
          "confidence": {"enum": ["high", "medium", "low"]},
          "evidence_ids": {"type": "array", "items": {"type": "string"}},
          "sanitizer_decision": {"type": "string"},
          "server_names": {"type": "array", "items": {"type": "string"}},
          "host_imported": {"const": false},
          "audit_only": {"const": true}
        }
      }
    },
    "skipped": {"type": "boolean"},
    "skip_reason": {"type": ["string", "null"]},
    "coverage": {"type": "object"}
  }
}
