{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Engine primitive subprocess log",
  "type": "object",
  "additionalProperties": false,
  "required": ["entries"],
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["timestamp", "primitive_id", "argv", "exit_code"],
        "properties": {
          "timestamp": {
            "type": "string",
            "pattern": "Z$"
          },
          "primitive_id": {
            "type": "string",
            "minLength": 1
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exit_code": {
            "type": "integer"
          },
          "error_type": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
