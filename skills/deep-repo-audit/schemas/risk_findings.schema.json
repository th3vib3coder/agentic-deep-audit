{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Risk Findings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "category",
          "severity",
          "confidence",
          "evidence_ids",
          "source_kind",
          "recommendation"
        ],
        "properties": {
          "finding_id": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^ev-[0-9]{6,}$"
            }
          },
          "source_tools": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_kind": {
            "enum": [
              "external_tool",
              "heuristic_promoted_with_tool_confirmation"
            ]
          },
          "recommendation": {
            "type": "string"
          },
          "requires_human_decision": {
            "type": "boolean"
          }
        }
      }
    },
    "promotion_policy": {
      "type": "string"
    },
    "source_tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
