{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Config Surface",
  "type": "object",
  "required": ["schema_version", "records"],
  "properties": {
    "schema_version": {"type": "string"},
    "run_id": {"type": ["string", "null"]},
    "repo": {"type": "object"},
    "source_artifacts": {"type": "array", "items": {"type": "string"}},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["surface_id", "kind", "source_path", "status", "confidence", "evidence_ids", "sanitizer_decision"],
        "properties": {
          "surface_id": {"type": "string"},
          "kind": {"enum": ["config_file", "env_var"]},
          "source_path": {"type": "string"},
          "status": {"enum": ["observed", "heuristic", "skipped"]},
          "confidence": {"enum": ["high", "medium", "low"]},
          "evidence_ids": {"type": "array", "items": {"type": "string"}},
          "sanitizer_decision": {"type": "string"},
          "name": {"type": ["string", "null"]},
          "value_read": {"const": false}
        }
      }
    },
    "skipped": {"type": "boolean"},
    "skip_reason": {"type": ["string", "null"]},
    "coverage": {"type": "object"}
  }
}
